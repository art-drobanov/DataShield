<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DataShield.Gui"
        xmlns:ctrl="clr-namespace:DataShield.Gui.Controls"
        x:Class="DataShield.Gui.MainWindow"
        Title="DataShield"
        Width="800"
        SizeToContent="Height"
         MinHeight="504" MinWidth="640" MaxWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Window.Resources>
        <local:EnumToBoolConverter x:Key="EnumToBool" />
        <local:EccVisibilityConverter x:Key="EccVis" />
        <local:NullToVisConverter x:Key="NullToVis" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="#466B8D" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePointerOver" Color="#176AB4" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePressed" Color="#0E528C" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#176AB4" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="White" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="White" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="White" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#4FB0E0" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#0E528C" />
        <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#176AB4" />
        <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#4FB0E0" />
        <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#0E528C" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="Border.statusCard">
            <Setter Property="Background" Value="#E3F1FA" />
        </Style>
        <Style Selector="Border.statusCard.error">
            <Setter Property="Background" Value="#FFEBEE" />
        </Style>
        <Style Selector="TextBlock.statusText">
            <Setter Property="Foreground" Value="#124E80" />
        </Style>
        <Style Selector="TextBlock.statusText.error">
            <Setter Property="Foreground" Value="#C62828" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#176AB4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4FB0E0" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#0E528C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Slider Thumb">
            <Setter Property="Background" Value="#176AB4" />
            <Setter Property="BorderBrush" Value="#176AB4" />
        </Style>
        <Style Selector="Slider:pointerover Thumb">
            <Setter Property="Background" Value="#4FB0E0" />
            <Setter Property="BorderBrush" Value="#4FB0E0" />
        </Style>
        <Style Selector="Slider:pressed Thumb">
            <Setter Property="Background" Value="#0E528C" />
            <Setter Property="BorderBrush" Value="#0E528C" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="#176AB4" />
        </Style>
    </Window.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- 0: Mode + Language -->
                <RowDefinition Height="Auto" />   <!-- 1: Input -->
                <RowDefinition Height="Auto" />   <!-- 2: Output -->
                <RowDefinition Height="Auto" />   <!-- 3: Slot name (decode) -->
                <RowDefinition Height="Auto" />   <!-- 4: Format -->
                <RowDefinition Height="Auto" />   <!-- 5: Redundancy block -->
                <RowDefinition Height="Auto" />   <!-- 6: Buttons -->
                <RowDefinition Height="Auto" />   <!-- 7: Progress -->
                <RowDefinition Height="Auto" />   <!-- 8: Status -->
                <RowDefinition Height="Auto" />   <!-- 9: Result header -->
                <RowDefinition Height="Auto" />   <!-- 10: Result content -->
                <RowDefinition Height="Auto" />   <!-- 11: Map header -->
                <RowDefinition Height="Auto" />   <!-- 12: Map content -->
            </Grid.RowDefinitions>

            <!-- ── Режим + язык ──────────────────────────────────────────── -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static local:UiStrings.ModeLabel}" VerticalAlignment="Center"
                               FontWeight="Medium" Margin="0,0,10,0" />
                    <RadioButton Content="{x:Static local:UiStrings.ModeEncode}" Margin="0,0,14,0" VerticalAlignment="Center"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumToBool},
                                          ConverterParameter=Encode}" />
                    <RadioButton Content="{x:Static local:UiStrings.ModeDecode}" VerticalAlignment="Center"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumToBool},
                                          ConverterParameter=Decode}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{x:Static local:UiStrings.LanguageLabel}" VerticalAlignment="Center"
                               FontWeight="Medium" Margin="0,0,10,0" />
                    <RadioButton Content="{x:Static local:UiStrings.LangEnglish}" Margin="0,0,14,0"
                                  VerticalAlignment="Center" Tag="English"
                                  IsChecked="{Binding Language, Converter={StaticResource EnumToBool},
                                           ConverterParameter=English}"
                                  Click="LanguageRadio_Click"
                                  IsEnabled="{Binding IsIdle}" />
                    <RadioButton Content="{x:Static local:UiStrings.LangRussian}" VerticalAlignment="Center"
                                  Tag="Russian"
                                  IsChecked="{Binding Language, Converter={StaticResource EnumToBool},
                                           ConverterParameter=Russian}"
                                  Click="LanguageRadio_Click"
                                  IsEnabled="{Binding IsIdle}" />
                </StackPanel>
            </Grid>

            <!-- ── Входной файл ──────────────────────────────────────────── -->
            <Grid Grid.Row="1" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Static local:UiStrings.InputFileLabel}"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Margin="8,0" Padding="4,2"
                         Text="{Binding InputPath}" />
                <Button Grid.Column="2" Content="{x:Static local:UiStrings.BrowseButton}"
                        Padding="10,2" Click="BrowseInput_Click" />
            </Grid>

            <!-- ── Выходной файл ─────────────────────────────────────────── -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Static local:UiStrings.OutputFileLabel}"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Margin="8,0" Padding="4,2"
                         Text="{Binding OutputPath}" />
                <Button Grid.Column="2" Content="{x:Static local:UiStrings.BrowseButton}"
                        Padding="10,2" Click="BrowseOutput_Click" />
            </Grid>

            <!-- ── Имя выходного файла из заголовка (декодирование) ─────── -->
            <CheckBox Grid.Row="3" Margin="0,0,0,8"
                      Content="{x:Static local:UiStrings.UseSlotName}"
                      IsChecked="{Binding UseSlotName}"
                      IsVisible="{Binding Mode, Converter={StaticResource EnumToBool},
                               ConverterParameter=Decode}" />

            <!-- ── Формат вывода ─────────────────────────────────────────── -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{x:Static local:UiStrings.FormatLabel}" VerticalAlignment="Center"
                           FontWeight="Medium" Margin="0,0,10,0" />
                <RadioButton Content="Base64" Margin="0,0,14,0" VerticalAlignment="Center"
                             IsChecked="{Binding SelectedFormat, Converter={StaticResource EnumToBool},
                                      ConverterParameter=Base64}" />
                <RadioButton Content="Binary" Margin="0,0,14,0" VerticalAlignment="Center"
                             IsChecked="{Binding SelectedFormat, Converter={StaticResource EnumToBool},
                                      ConverterParameter=Binary}" />
            </StackPanel>

            <!-- ── Избыточность (рамка со слайдерами) ────────────────────── -->
            <Border Grid.Row="5" Margin="0,0,0,8" Padding="8,5"
                    BorderBrush="#B8DAEF" BorderThickness="1" CornerRadius="4"
                    IsVisible="{Binding Mode, Converter={StaticResource EccVis}}">
                <StackPanel>
                    <TextBlock Text="{x:Static local:UiStrings.RedundancyHeader}"
                               FontWeight="Medium" Margin="0,0,0,4" />

                    <!-- ECC избыточность -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Static local:UiStrings.EccLabel}"
                                   VerticalAlignment="Center" />
                        <Slider Grid.Column="1" VerticalAlignment="Center" Margin="8,0"
                                MinHeight="18" Padding="0,1"
                                Minimum="0" Maximum="1000"
                                SmallChange="5" LargeChange="50"
                                Value="{Binding EccPercent}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace"
                                   Text="{Binding EccPercent, StringFormat={}{0}%}" />
                    </Grid>

                    <!-- Заголовки -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Static local:UiStrings.HeadersLabel}"
                                   VerticalAlignment="Center" />
                        <Slider Grid.Column="1" VerticalAlignment="Center" Margin="8,0"
                                MinHeight="18" Padding="0,1"
                                Minimum="0" Maximum="50"
                                SmallChange="1" LargeChange="5"
                                Value="{Binding HeaderPercent}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace"
                                   Text="{Binding HeaderPercent, StringFormat={}{0}%}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Кнопки ────────────────────────────────────────────────── -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Classes="primary" Content="{x:Static local:UiStrings.RunButton}"
                        Padding="20,4" FontWeight="Medium"
                        Command="{Binding RunCommand}" Margin="0,0,8,0" />
                <Button Content="{x:Static local:UiStrings.CancelButton}" Padding="14,4"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding IsRunning}" />
            </StackPanel>

            <!-- ── Прогресс ──────────────────────────────────────────────── -->
            <StackPanel Grid.Row="7" Margin="0,0,0,4">
                <Grid>
                    <TextBlock Text="{x:Static local:UiStrings.ProgressCaption}" FontSize="11"
                               VerticalAlignment="Center" />
                    <TextBlock HorizontalAlignment="Right" FontSize="11"
                               Text="{Binding ProgressPercent, StringFormat={}{0}%}" />
                </Grid>
                <ProgressBar Height="18" Margin="0,1"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             Minimum="0" Maximum="100" />
                <TextBlock Text="{Binding PhaseLabel}" FontSize="11"
                           />
            </StackPanel>

            <!-- ── Статус ────────────────────────────────────────────────── -->
            <Border Grid.Row="8" Margin="0,2,0,8" Padding="8,3" CornerRadius="3"
                    Classes="statusCard" Classes.error="{Binding StatusIsError}"
                    IsVisible="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding StatusMessage}" FontWeight="Medium"
                           Classes="statusText" Classes.error="{Binding StatusIsError}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- ── Результат: заголовок ──────────────────────────────────── -->
            <TextBlock Grid.Row="9" Text="{x:Static local:UiStrings.ResultCaption}"
                       FontWeight="SemiBold" Foreground="#124E80" Margin="0,0,0,3" />

            <!-- ── Результат: содержимое ─────────────────────────────────── -->
            <Border Grid.Row="10" Background="White" BorderBrush="#B8DAEF"
                    BorderThickness="1" CornerRadius="3" Padding="8"
                    Margin="0,0,0,8" Height="220">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ResultLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace"
                                            FontSize="15" Foreground="#124E80"
                                           TextWrapping="NoWrap" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ── Карта: заголовок ─────────────────────────────────────── -->
            <TextBlock Grid.Row="11" Text="{x:Static local:UiStrings.MapCaption}"
                       FontWeight="SemiBold" Foreground="#124E80" Margin="0,0,0,3" />

            <!-- ── Карта: содержимое ────────────────────────────────────── -->
            <Border Grid.Row="12" Background="White" BorderBrush="#B8DAEF"
                    BorderThickness="1" CornerRadius="3" Height="164" Padding="0,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ctrl:SectorMapControl Grid.Row="0" Margin="4,0"
                                           ValidityMap="{Binding ValidityMap}"
                                           CollisionMap="{Binding CollisionMap}"
                                           DataCount="{Binding MapDataCount}" />

                    <!-- Легенда мини-карты (кодирование и декодирование) -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14"
                                Margin="8,2,8,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border Width="10" Height="10" CornerRadius="2"
                                    Background="#66BB6A" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static local:UiStrings.MapLegendData}"
                                       FontSize="11" Foreground="#124E80"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border Width="10" Height="10" CornerRadius="2"
                                    Background="#64B5F6" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static local:UiStrings.MapLegendEcc}"
                                       FontSize="11" Foreground="#124E80"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border Width="10" Height="10" CornerRadius="2"
                                    Background="#FFC107" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static local:UiStrings.MapLegendCollision}"
                                       FontSize="11" Foreground="#124E80"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border Width="10" Height="10" CornerRadius="2"
                                    Background="#E55759" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static local:UiStrings.MapLegendMissing}"
                                       FontSize="11" Foreground="#124E80"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
